---
// src/pages/terms.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/landing/Header.astro';
import Footer from '../components/landing/Footer.astro';

const lastUpdated = "November 24, 2026";
---

<Layout
  title="Terms & Conditions – Quote Generator Free"
  description="Review the Terms and Conditions for using Quote Generator Free. Free, unrestricted, and watermark-free estimate and quotation creation software for commercial and personal use."
  canonicalPath="/terms"
  breadcrumbTitle="Terms & Conditions"
>
  <Header />

  <main class="flex-1 w-full bg-[#fafafa] dark:bg-[#09090b] text-[#171717] dark:text-[#ededed] py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-8 font-mono">
        <a href="/" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Home</a>
        <span class="text-neutral-300 dark:text-neutral-700">/</span>
        <span class="text-neutral-900 dark:text-neutral-100 font-semibold">Terms & Conditions</span>
      </nav>

      <!-- Page Header -->
      <div class="border-b border-neutral-200 dark:border-neutral-800 pb-8 mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/60 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
          Free Commercial & Personal Use Agreement
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
          Terms & Conditions
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
          Last revised: <time datetime="2026-11-24" class="font-mono text-neutral-900 dark:text-neutral-200">{lastUpdated}</time>
        </p>
      </div>

      <!-- Quick Summary Card -->
      <div class="p-6 sm:p-7 rounded-2xl bg-neutral-100/70 dark:bg-neutral-900/70 border border-neutral-200 dark:border-neutral-800 mb-12 space-y-4">
        <h2 class="text-xs font-semibold tracking-wider uppercase text-neutral-900 dark:text-neutral-100 font-mono">
          Terms at a Glance
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong class="text-neutral-900 dark:text-white">100% Free:</strong> No hidden subscriptions, no credit card requirements, and zero watermarks.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong class="text-neutral-900 dark:text-white">Full Ownership:</strong> You retain 100% ownership of all quotes, line items, pricing, and logos.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong class="text-neutral-900 dark:text-white">Commercial License:</strong> Permitted for freelancers, contractors, agencies, and corporations.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong class="text-neutral-900 dark:text-white">User Responsibility:</strong> Users are responsible for confirming numbers and local tax compliance.</span>
          </li>
        </ul>
      </div>

      <!-- Legal Content Body -->
      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
        
        <!-- Section 1 -->
        <section id="agreement" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            1. Agreement to Terms
          </h2>
          <p>
            By accessing or using <strong>Quote Generator Free</strong> (the "Service," accessible at 
            <a href="https://quotegeneratorfree.com" class="text-neutral-950 dark:text-white underline underline-offset-4 font-medium hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors">https://quotegeneratorfree.com</a>), 
            you agree to be bound by these Terms & Conditions ("Terms"). If you do not agree to these Terms, you may discontinue use of the Service at any time.
          </p>
        </section>

        <!-- Section 2 -->
        <section id="service-description" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            2. Description of the Service
          </h2>
          <p>
            Quote Generator Free is a free, web-based quotation and sales estimate builder. The application enables users to enter line items, calculate multi-tier taxes, include custom company logos, add digital signatures, choose visual templates, preview documents in real-time A4 format, and export professional PDF quotations.
          </p>
          <p>
            The software operates client-side directly within your web browser without requiring user accounts, passwords, or cloud data synchronization.
          </p>
        </section>

        <!-- Section 3 -->
        <section id="commercial-use" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            3. Permitted & Commercial Use
          </h2>
          <p>
            We grant you a worldwide, royalty-free, non-exclusive license to use Quote Generator Free for:
          </p>
          <ul class="space-y-2.5 pl-6 list-disc text-neutral-700 dark:text-neutral-300 my-3">
            <li>Creating commercial quotations, estimates, bids, proposals, and invoices for your clients and customers.</li>
            <li>Printing physical copies or emailing generated PDF documents for legitimate commercial transactions.</li>
            <li>Managing internal estimation workflows for freelancers, trade contractors, agencies, and businesses of all sizes.</li>
          </ul>
        </section>

        <!-- Section 4 -->
        <section id="prohibited-use" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            4. Prohibited Uses
          </h2>
          <p>
            You agree not to use Quote Generator Free to:
          </p>
          <ul class="space-y-2.5 pl-6 list-disc text-neutral-700 dark:text-neutral-300 my-3">
            <li>Generate fraudulent, forged, or counterfeit commercial invoices or quotes.</li>
            <li>Engage in deceptive impersonation, phishing, or social engineering schemes against individuals or organizations.</li>
            <li>Bill for illegal substances, unauthorized weapons, or unlawful activities.</li>
            <li>Attempt to disrupt, reverse-engineer, or compromise the availability and security of our web infrastructure.</li>
          </ul>
        </section>

        <!-- Section 5 -->
        <section id="intellectual-property" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            5. Intellectual Property Rights
          </h2>
          
          <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 pt-2">
            A. Your Content Belongs Entirely to You
          </h3>
          <p>
            You retain sole and unencumbered ownership of all data, descriptions, business trademarks, brand logos, signatures, and pricing structures entered into the tool. Quote Generator Free claims zero copyright, licensing, or intellectual property rights over any quotes or documents you create.
          </p>

          <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 pt-4">
            B. Platform Property
          </h3>
          <p>
            The website design, layout templates (Nordic, Corporate, Modern, Minimalist, Creative), user interface, visual branding, and underlying code are the intellectual property of Quote Generator Free and are protected by applicable intellectual property laws.
          </p>
        </section>

        <!-- Section 6 -->
        <section id="disclaimer" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            6. Disclaimer of Warranties ("As Is")
          </h2>
          <p>
            The Service is provided on an <strong>"AS IS"</strong> and <strong>"AS AVAILABLE"</strong> basis without warranties of any kind, whether express, statutory, or implied, including but not limited to implied warranties of merchantability, fitness for a particular purpose, or non-infringement.
          </p>
          
          <div class="p-5 rounded-2xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-900/60 text-xs sm:text-sm text-amber-950 dark:text-amber-200 my-4 leading-relaxed">
            <strong class="font-semibold text-amber-900 dark:text-amber-100">Notice on Mathematical & Tax Calculations:</strong> While our calculation engines undergo extensive testing, you as the user are responsible for verifying mathematical calculations, applicable tax rates (VAT, GST, HST, sales tax), and compliance with statutory invoicing requirements in your region.
          </div>
        </section>

        <!-- Section 7 -->
        <section id="liability" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            7. Limitation of Liability
          </h2>
          <p>
            To the maximum extent permitted by applicable law, in no event shall Quote Generator Free, its maintainers, or contributors be liable for any indirect, incidental, special, consequential, or punitive damages, including:
          </p>
          <ul class="space-y-2.5 pl-6 list-disc text-neutral-700 dark:text-neutral-300 my-3">
            <li>Loss of profits, revenue, or business contracts.</li>
            <li>Disagreements between you and your clients regarding estimate pricing or terms.</li>
            <li>Loss of quotation data resulting from clearing browser history, hardware malfunction, or system crashes.</li>
            <li>Any temporary interruption or unavailability of the website.</li>
          </ul>
        </section>

        <!-- Section 8 -->
        <section id="third-parties" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            8. Third-Party Links & Resources
          </h2>
          <p>
            The Service may reference third-party software libraries or external documentation. We do not control or assume responsibility for the content, privacy policies, or practices of any external sites or services.
          </p>
        </section>

        <!-- Section 9 -->
        <section id="governing-law" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            9. Governing Law & Severability
          </h2>
          <p>
            These Terms shall be governed by and construed in accordance with general commercial law principles. If any provision of these Terms is deemed invalid or unenforceable, that provision will be severed without affecting the validity and enforceability of the remaining provisions.
          </p>
        </section>

        <!-- Section 10 -->
        <section id="contact" class="space-y-4 border-t border-neutral-200 dark:border-neutral-800 pt-8">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
            10. Contact Information
          </h2>
          <p>
            If you have questions, feedback, or legal inquiries concerning these Terms & Conditions, please contact us at:
          </p>
          <div class="p-4 rounded-xl bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 w-fit font-mono text-xs sm:text-sm">
            <span class="text-neutral-500 dark:text-neutral-400">Email: </span>
            <a href="mailto:legal@quotegeneratorfree.com" class="font-semibold text-neutral-900 dark:text-neutral-100 hover:underline">
              legal@quotegeneratorfree.com
            </a>
          </div>
        </section>

      </div>

      <!-- Bottom Navigation / Call to Action -->
      <div class="mt-14 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="text-xs sm:text-sm font-semibold text-neutral-900 dark:text-neutral-100 hover:underline flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Return to Quote Generator
        </a>
        <div class="flex items-center gap-4 text-xs text-neutral-500 dark:text-neutral-400">
          <a href="/privacy-policy" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Privacy Policy</a>
          <span>·</span>
          <a href="/contact" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Contact Support</a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
