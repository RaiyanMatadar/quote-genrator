---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/landing/Header.astro';
import Footer from '../components/landing/Footer.astro';
---

<Layout
  title="Contact Us – Quote Generator Free"
  description="Have questions, feature suggestions, or need assistance? Get in touch with the Quote Generator Free team. We're here to help."
  canonicalPath="/contact"
  breadcrumbTitle="Contact Us"
>
  <Header />

  <main class="flex-1 w-full bg-[#fafafa] dark:bg-[#09090b] text-[#171717] dark:text-[#ededed] py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-8 font-mono">
        <a href="/" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Home</a>
        <span class="text-neutral-300 dark:text-neutral-700">/</span>
        <span class="text-neutral-900 dark:text-neutral-100 font-semibold">Contact Us</span>
      </nav>

      <!-- Page Header -->
      <div class="border-b border-neutral-200 dark:border-neutral-800 pb-8 mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 mb-4 font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Direct Support & Community Feedback
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
          Get in Touch
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
          Have an idea for a new quote template, discovered an issue, or want to share feedback? We value every inquiry and respond to messages attentively.
        </p>
      </div>

      <!-- Two-Column Grid: Contact Information & Interactive Contact Form -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Contact Cards & Info (lg:col-span-5) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Direct Email Cards -->
          <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#121215] border border-neutral-200 dark:border-neutral-800 space-y-4 shadow-2xs">
            <h2 class="text-base font-bold text-neutral-950 dark:text-white flex items-center gap-2.5">
              <svg class="w-4 h-4 text-neutral-600 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Direct Email Support
            </h2>
            
            <div class="space-y-3 text-xs sm:text-sm">
              <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase tracking-wider mb-1">Help & Inquiries</span>
                <a href="mailto:support@quotegeneratorfree.com" class="font-semibold text-neutral-900 dark:text-neutral-100 hover:underline">
                  support@quotegeneratorfree.com
                </a>
              </div>

              <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase tracking-wider mb-1">Feedback & Template Ideas</span>
                <a href="mailto:feedback@quotegeneratorfree.com" class="font-semibold text-neutral-900 dark:text-neutral-100 hover:underline">
                  feedback@quotegeneratorfree.com
                </a>
              </div>

              <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase tracking-wider mb-1">Commercial & Partnerships</span>
                <a href="mailto:partnerships@quotegeneratorfree.com" class="font-semibold text-neutral-900 dark:text-neutral-100 hover:underline">
                  partnerships@quotegeneratorfree.com
                </a>
              </div>
            </div>
          </div>

          <!-- FAQ & Quick Answers Box -->
          <div class="p-6 sm:p-7 rounded-2xl bg-neutral-100/70 dark:bg-neutral-900/70 border border-neutral-200 dark:border-neutral-800 space-y-4">
            <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">
              Frequently Asked Support Topics
            </h3>
            <ul class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 space-y-3.5">
              <li>
                <strong class="text-neutral-900 dark:text-neutral-200 block mb-0.5">Where are my quotation drafts saved?</strong>
                <p class="leading-relaxed">Drafts are saved directly inside your browser's local memory. You can view or restore previous quotes via the "History" button on the toolbar.</p>
              </li>
              <li>
                <strong class="text-neutral-900 dark:text-neutral-200 block mb-0.5">Are there any hidden fees or limits?</strong>
                <p class="leading-relaxed">None. All 5 designer templates, instant PDF downloads, and custom logo uploads are 100% free with zero watermarks.</p>
              </li>
              <li>
                <strong class="text-neutral-900 dark:text-neutral-200 block mb-0.5">Looking for more answers?</strong>
                <p class="leading-relaxed">Explore our full <a href="/#faq" class="text-neutral-950 dark:text-white underline underline-offset-2 font-medium hover:text-neutral-700">FAQ Section</a> or read our <a href="/privacy-policy" class="text-neutral-950 dark:text-white underline underline-offset-2 font-medium hover:text-neutral-700">Privacy Policy</a>.</p>
              </li>
            </ul>
          </div>

          <!-- Response Commitment -->
          <div class="flex items-center gap-3 p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-800/40 text-xs sm:text-sm text-emerald-900 dark:text-emerald-300">
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>We aim to respond to all inquiries within <strong>24 to 48 business hours</strong>.</span>
          </div>

        </div>

        <!-- Right Column: Interactive Contact Form (lg:col-span-7) -->
        <div class="lg:col-span-7">
          <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121215] border border-neutral-200 dark:border-neutral-800 shadow-sm">
            <h2 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white mb-2">
              Send a Message
            </h2>
            <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mb-6 leading-relaxed">
              Complete the form below to get in touch. You can also email us directly at <a href="mailto:support@quotegeneratorfree.com" class="font-mono text-neutral-900 dark:text-neutral-200 underline font-medium">support@quotegeneratorfree.com</a>.
            </p>

            <form id="contact-form" class="space-y-5">
              
              <!-- Name & Email Row -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-2">
                  <label for="contact-name" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300">
                    Your Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder="e.g. Sarah Jenkins"
                    class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-white transition-colors"
                  />
                </div>

                <div class="space-y-2">
                  <label for="contact-email" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300">
                    Your Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="sarah@example.com"
                    class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-white transition-colors"
                  />
                </div>
              </div>

              <!-- Subject / Topic Dropdown -->
              <div class="space-y-2">
                <label for="contact-topic" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300">
                  Topic / Category <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select
                    id="contact-topic"
                    name="topic"
                    required
                    class="w-full pl-3.5 pr-8 py-2.5 text-xs sm:text-sm rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white cursor-pointer focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-white"
                  >
                    <option value="General Inquiry">General Inquiry</option>
                    <option value="Feature Suggestion">Feature Suggestion or Template Request</option>
                    <option value="Bug Report">Bug Report / Technical Issue</option>
                    <option value="Commercial / Partnership">Commercial Partnership</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>

              <!-- Message Field -->
              <div class="space-y-2">
                <label for="contact-message" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300">
                  Your Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Tell us what is on your mind, what template or feature you would like to see, or any questions you have..."
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-white transition-colors resize-y leading-relaxed"
                ></textarea>
              </div>

              <!-- Submit Button & Feedback status -->
              <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
                <button
                  type="submit"
                  id="contact-submit-btn"
                  class="w-full sm:w-auto px-7 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                  <span>Send Message</span>
                </button>

                <span class="text-[11px] text-neutral-400 text-center sm:text-right font-mono">
                  100% Client-Side Privacy Guaranteed
                </span>
              </div>

              <!-- Success Alert (Hidden by default) -->
              <div
                id="contact-success-alert"
                class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 text-xs sm:text-sm text-emerald-800 dark:text-emerald-300 space-y-1.5"
              >
                <div class="font-bold flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Thank you! Your message has been prepared.
                </div>
                <p class="leading-relaxed">
                  Your email client has been launched with your note prefilled. You can also write to us directly at <a href="mailto:support@quotegeneratorfree.com" class="underline font-semibold">support@quotegeneratorfree.com</a>.
                </p>
              </div>

            </form>
          </div>
        </div>

      </div>

      <!-- Bottom Navigation / Call to Action -->
      <div class="mt-14 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="text-xs sm:text-sm font-semibold text-neutral-900 dark:text-neutral-100 hover:underline flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Return to Quote Generator
        </a>
        <div class="flex items-center gap-4 text-xs text-neutral-500 dark:text-neutral-400">
          <a href="/about" class="hover:text-neutral-900 dark:hover:text-white transition-colors">About Us</a>
          <span>·</span>
          <a href="/privacy-policy" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Privacy Policy</a>
          <span>·</span>
          <a href="/terms" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Terms of Service</a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const successAlert = document.getElementById('contact-success-alert');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (contactForm && successAlert && submitBtn) {
    contactForm.addEventListener('submit', function (e) {
      e.preventDefault();

      const name = document.getElementById('contact-name')?.value || '';
      const email = document.getElementById('contact-email')?.value || '';
      const topic = document.getElementById('contact-topic')?.value || 'General Inquiry';
      const message = document.getElementById('contact-message')?.value || '';

      // Prepare mailto link with prefilled subject and body
      const mailtoSubject = encodeURIComponent(`[${topic}] from ${name}`);
      const mailtoBody = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\nMessage:\n${message}`);
      const mailtoUrl = `mailto:support@quotegeneratorfree.com?subject=${mailtoSubject}&body=${mailtoBody}`;

      // Show success message
      successAlert.classList.remove('hidden');
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

      // Attempt to launch client email
      window.location.href = mailtoUrl;

      // Reset form after short delay
      setTimeout(() => {
        contactForm.reset();
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }, 3000);
    });
  }
</script>
