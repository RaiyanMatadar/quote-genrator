---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quote Generator – Free Quotation Generator Software & Estimate Builder",
  description = "Free quote generator and quotation generator software. Create professional estimates, custom PDF quotes, and sales proposals with our automated quote builder. 100% free."
} = Astro.props;

const canonicalUrl = "https://quotegeneratorfree.com";
const ogImageUrl = "https://quotegeneratorfree.com/og-image.png";

const seoKeywords = [
  "quote generator",
  "quotation generator",
  "quotation generator software",
  "quote and proposal software",
  "sales quote software",
  "estimate generator",
  "quote builder",
  "quote creation tool",
  "digital quote software",
  "quote template",
  "free quote template",
  "printable quote generator",
  "pdf quote generator",
  "custom quote generator",
  "construction quote generator",
  "contractor quote software",
  "freelance quote generator",
  "service quote software",
  "b2b quote generator",
  "wholesale quote generator",
  "quote management software",
  "client quote approval software",
  "quote to invoice software",
  "cpq software",
  "automated quote generator"
].join(", ");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalUrl}/#webapp`,
      "name": "Quote Generator Free",
      "alternateName": [
        "Quote Generator",
        "Quotation Generator",
        "Quotation Generator Software",
        "Free Estimate Generator",
        "Digital Quote Builder",
        "PDF Quote Generator"
      ],
      "url": canonicalUrl,
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "softwareVersion": "2.0.0",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "1280",
        "bestRating": "5",
        "worstRating": "1"
      },
      "featureList": [
        "Universal Logo Engine supporting PNG, JPG, SVG, WebP, and GIF",
        "Instant Real-Time A4 PDF Preview & Printable Quote Generator",
        "100% Client-Side Private Generation without Server Data Storage",
        "150+ Currencies and Multi-Tax Dynamic Calculation Engine",
        "5 Designer Quote Templates with Custom Color Themes",
        "Built-in Digital Signature Pad for Client Quote Approval",
        "Lightweight CPQ Software Line Items and Discount Automation",
        "Seamless Quote to Invoice Software Transition Data"
      ]
    },
    {
      "@type": "Organization",
      "@id": `${canonicalUrl}/#organization`,
      "name": "Quote Generator Free",
      "url": canonicalUrl,
      "logo": {
        "@type": "ImageObject",
        "url": ogImageUrl,
        "width": 1200,
        "height": 630
      }
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}/#website`,
      "url": canonicalUrl,
      "name": "Quote Generator Free",
      "publisher": {
        "@id": `${canonicalUrl}/#organization`
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is Quote Generator Free truly 100% free with no hidden charges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! You can create, preview, customize, and download unlimited PDF quotations and estimates completely free of charge. There are no subscriptions, no credit cards required, and no hidden paywalls."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to create an account or sign in to use this quotation generator software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No registration or account creation is required. You can launch the quote builder immediately upon landing on the site, draft your estimate, and download a professional PDF in seconds."
          }
        },
        {
          "@type": "Question",
          "name": "Is my client, company, and financial data secure and private?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. Unlike traditional SaaS cloud tools that store your sensitive commercial data on remote servers, Quote Generator Free executes 100% in your browser. Nothing is ever sent to or stored on an external database."
          }
        },
        {
          "@type": "Question",
          "name": "Can contractors, freelancers, and B2B wholesalers use this quote creation tool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our quote generator provides specialized features for construction quote generation, contractor line items, freelance milestones, and B2B/wholesale bulk discounts with multi-tier taxes and currencies."
          }
        },
        {
          "@type": "Question",
          "name": "Does the software support client quote approvals with digital signatures?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The built-in digital signature pad allows you and your clients to sign directly using a touchscreen or mouse, or type an authorized name to create legally clear, signed quotes ready for instant sign-off."
          }
        },
        {
          "@type": "Question",
          "name": "How does this quote builder compare to complex CPQ software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditional CPQ (Configure, Price, Quote) platforms take weeks to configure and cost thousands of dollars per seat. Our automated quote generator delivers the essential Configure-Price-Quote capabilities—line items, percentage discounts, multi-tax calculations, and dynamic totals—with zero setup time and zero cost."
          }
        },
        {
          "@type": "Question",
          "name": "What logo formats and designer quote templates are supported?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our Universal Logo Engine supports PNG, JPG, JPEG, SVG vector graphics, WebP, and GIF. You can customize five designer quote templates (Minimalist, Corporate, Creative, Nordic, and Compact) with your unique brand accent colors."
          }
        },
        {
          "@type": "Question",
          "name": "Can I convert quotes into invoices or export printable PDF quotes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You can switch between \"Quote\" and \"Invoice\" titles instantly, reuse existing quote line items for final billing, and export high-resolution vector PDF documents calibrated for A4 and Letter printing."
          }
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Instant Dark Mode & Language Detection Script (Prevents FOUC) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && systemDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }

          // Auto-respond to system theme changes if user hasn't explicitly set preference
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
            if (!localStorage.getItem('theme')) {
              if (e.matches) {
                document.documentElement.classList.add('dark');
              } else {
                document.documentElement.classList.remove('dark');
              }
            }
          });

          // Set initial website language and direction
          const storedLang = localStorage.getItem('site_language') || 'en';
          document.documentElement.lang = storedLang;
          document.documentElement.dir = storedLang === 'ar' ? 'rtl' : 'ltr';
        } catch (e) {}
      })();
    </script>

    <!-- Client-side global i18n orchestrator -->
    <script>
      import '../scripts/i18n';
    </script>

    <!-- Essential Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Quote Generator Free" />
    <meta name="application-name" content="Quote Generator Free" />
    <meta name="apple-mobile-web-app-title" content="Quote Generator" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Open Graph / Facebook / LinkedIn Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Quote Generator Free" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Quote Generator Free - Online Quotation Generator Software & Estimate Builder" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Quote Generator Free - Online Quotation Generator Software & Estimate Builder" />

    <!-- Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD (Graph: WebApplication, Organization, WebSite, FAQPage) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#fafafa] dark:bg-[#09090b] text-[#171717] dark:text-[#ededed] min-h-screen flex flex-col font-sans selection:bg-neutral-900 dark:selection:bg-neutral-100 selection:text-white dark:selection:text-neutral-900 transition-colors duration-200">
    <slot />
  </body>
</html>
