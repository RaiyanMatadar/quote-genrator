---
// src/components/landing/Header.astro
---

<header class="sticky top-0 z-40 w-full bg-white/80 backdrop-blur-md border-b border-neutral-200/80 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-7 h-7 rounded-md bg-neutral-900 flex items-center justify-center text-white font-bold text-sm tracking-tight group-hover:scale-105 transition-transform">
        Q
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-sm tracking-tight text-neutral-950">Quote Generator Free</span>
        <span class="text-[10px] font-mono uppercase bg-neutral-100 text-neutral-600 px-1.5 py-0.5 rounded font-medium">Free</span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6 text-xs text-neutral-600">
      <a href="#editor" class="hover:text-neutral-950 transition-colors">Generator</a>
      <a href="#features" class="hover:text-neutral-950 transition-colors">Features</a>
      <a href="#templates" class="hover:text-neutral-950 transition-colors">Templates</a>
      <a href="#faq" class="hover:text-neutral-950 transition-colors">FAQ</a>
    </nav>

    <!-- Right CTA -->
    <div class="flex items-center gap-3">
      <a
        href="#editor"
        class="inline-flex items-center justify-center px-4 py-1.5 text-xs font-semibold text-white bg-neutral-900 hover:bg-neutral-800 rounded-full transition-colors shadow-2xs"
      >
        Create Quote
      </a>
    </div>
  </div>
</header>
