---
// src/components/landing/Features.astro
---

<section id="features" class="py-16 bg-white dark:bg-[#09090b] border-t border-neutral-200 dark:border-neutral-800 transition-colors no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-medium">Why Quote Generator Free</span>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-950 dark:text-white">
        Everything you need to send winning estimates
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
        Engineered with zero fluff. Every feature is built to give your business an edge without subscriptions or registrations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Feature 1 -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-bold text-sm">
          ❖
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Universal Logo Engine</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Upload any format including PNG, JPG, WebP, SVG vectors, and GIF. Easily adjust the logo size slider and alignment to fit your brand identity cleanly.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-bold text-sm">
          👁
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Real-Time PDF Preview</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Never guess how your document will look. The responsive A4 preview canvas updates at 60fps as you type, with zoom controls and print margins.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-bold text-sm">
          🌍
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">12+ Multilingual Support</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Switch the entire website interface into English, Spanish, French, German, Arabic (RTL), Portuguese, Japanese, and more with one click.
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-bold text-sm">
          🎨
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">5 Designer Templates</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Choose from Modern Minimalist, Executive Corporate, Creative Studio, Nordic Clean, and Compact Tech. Personalize with custom brand accent colors.
        </p>
      </div>

      <!-- Feature 5 -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-bold text-sm">
          🔒
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">100% Client-Side Privacy</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Your customer information, rates, and quotes never touch an external server or cloud database. All processing runs locally inside your browser with auto-saving.
        </p>
      </div>

      <!-- Feature 6 -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-bold text-sm">
          ✍
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Digital Signature Pad</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Include a legal client acceptance and authorized signature block. Sign directly with a touch screen or mouse, or type an authorized name with date stamps.
        </p>
      </div>
    </div>
  </div>
</section>
