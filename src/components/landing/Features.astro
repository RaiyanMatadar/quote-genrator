---
// src/components/landing/Features.astro
---

<section id="features" class="py-16 bg-white dark:bg-[#09090b] border-t border-neutral-200 dark:border-neutral-800 transition-colors no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span data-i18n="featuresEyebrow" class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-medium">Why Quote Generator Free</span>
      <h2 data-i18n="featuresTitle" class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-950 dark:text-white">
        Everything you need to send winning estimates
      </h2>
      <p data-i18n="featuresSubtitle" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
        Engineered with zero fluff. Every feature is built to give your business an edge without subscriptions or registrations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Feature 1: Universal Logo Engine -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Universal Logo Engine</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Upload any format including PNG, JPG, WebP, SVG vectors, and GIF. Easily adjust the logo size slider and alignment to fit your brand identity cleanly.
        </p>
      </div>

      <!-- Feature 2: Real-Time PDF Preview -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Real-Time PDF Preview</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Never guess how your document will look. The responsive A4 preview canvas updates at 60fps as you type, with zoom controls and print margins.
        </p>
      </div>

      <!-- Feature 3: 12+ Multilingual Support -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">12+ Multilingual Support</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Switch the entire website interface into English, Spanish, French, German, Arabic (RTL), Portuguese, Japanese, and more with one click.
        </p>
      </div>

      <!-- Feature 4: 5 Designer Templates -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">5 Designer Templates</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Choose from Modern Minimalist, Executive Corporate, Creative Studio, Nordic Clean, and Compact Tech. Personalize with custom brand accent colors.
        </p>
      </div>

      <!-- Feature 5: 100% Client-Side Privacy -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">100% Client-Side Privacy</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Your customer information, rates, and quotes never touch an external server or cloud database. All processing runs locally inside your browser with auto-saving.
        </p>
      </div>

      <!-- Feature 6: Digital Signature Pad -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors space-y-3">
        <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Digital Signature Pad</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Include a legal client acceptance and authorized signature block. Sign directly with a touch screen or mouse, or type an authorized name with date stamps.
        </p>
      </div>
    </div>
  </div>
</section>
