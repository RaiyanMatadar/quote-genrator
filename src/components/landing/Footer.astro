---
// src/components/landing/Footer.astro
---

<footer class="py-12 bg-white dark:bg-[#09090b] border-t border-neutral-200 dark:border-neutral-800 text-xs text-neutral-500 dark:text-neutral-400 transition-colors no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-[#020202] dark:bg-white text-white dark:text-[#020202] flex items-center justify-center shrink-0 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white dark:text-[#020202]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
            <polyline points="14 2 14 8 20 8" />
            <path d="m16 13-3.5 3.5-2-2L8 17" />
          </svg>
        </div>
        <span class="font-bold text-neutral-950 dark:text-white text-sm">Quote Generator Free</span>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <a href="#editor" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Generator</a>
        <a href="#features" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Features</a>
        <a href="#seo-overview" class="hover:text-neutral-900 dark:hover:text-white transition-colors">Industry Guide</a>
        <a href="#faq" class="hover:text-neutral-900 dark:hover:text-white transition-colors">FAQ</a>
        <a href="https://quotegeneratorfree.com" class="hover:text-neutral-900 dark:hover:text-white transition-colors">quotegeneratorfree.com</a>
      </div>
    </div>

    <div class="pt-6 border-t border-neutral-100 dark:border-neutral-800/80 flex flex-col sm:flex-row justify-between items-center gap-2 text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">
      <p data-i18n="footerCopyright">© {new Date().getFullYear()} Quote Generator Free. 100% Free & Open In-Browser Tool.</p>
      <p data-i18n="footerNotice">No cookies · No database storage · Zero tracking</p>
    </div>
  </div>
</footer>
