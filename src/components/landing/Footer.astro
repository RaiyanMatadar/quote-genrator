---
// src/components/landing/Footer.astro
const year = new Date().getFullYear();
---

<footer class="bg-white dark:bg-[#09090b] border-t border-neutral-200 dark:border-neutral-800 text-xs text-neutral-600 dark:text-neutral-400 transition-colors no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-8 sm:gap-10 pb-10 border-b border-neutral-100 dark:border-neutral-800/80">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2 group w-fit">
          <div class="w-7 h-7 rounded-md bg-[#020202] dark:bg-white text-white dark:text-[#020202] flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white dark:text-[#020202]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
              <path d="m16 13-3.5 3.5-2-2L8 17" />
            </svg>
          </div>
          <span class="font-bold text-neutral-950 dark:text-white text-sm sm:text-base tracking-tight">Quote Generator Free</span>
        </a>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-sm">
          A modern, high-speed, 100% free quotation generator software. Build professional estimates, custom PDF quotes, and sales proposals in seconds with zero signup, zero watermarks, and client-side privacy.
        </p>
        <div class="flex flex-wrap items-center gap-2 pt-1 font-mono text-[10px] text-neutral-500 dark:text-neutral-400">
          <span class="px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700">Client-Side Only</span>
          <span class="px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700">100% Free Forever</span>
          <span class="px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700">Zero Tracking</span>
        </div>
      </div>

      <!-- Product Links -->
      <div class="space-y-3">
        <p class="text-[11px] font-mono uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100">Product</p>
        <ul class="space-y-2">
          <li>
            <a href="/#editor" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Quotation Builder</a>
          </li>
          <li>
            <a href="/#features" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Features & Tools</a>
          </li>
          <li>
            <a href="/#editor" class="hover:text-neutral-950 dark:hover:text-white transition-colors">PDF Templates</a>
          </li>
          <li>
            <a href="/#seo-overview" class="hover:text-neutral-950 dark:hover:text-white transition-colors">CPQ & Quoting Guide</a>
          </li>
          <li>
            <a href="/#faq" class="hover:text-neutral-950 dark:hover:text-white transition-colors">FAQs</a>
          </li>
        </ul>
      </div>

      <!-- Company Links -->
      <div class="space-y-3">
        <p class="text-[11px] font-mono uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100">Company</p>
        <ul class="space-y-2">
          <li>
            <a href="/about" class="hover:text-neutral-950 dark:hover:text-white transition-colors">About Us</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Contact Us</a>
          </li>
          <li>
            <a href="/about#mission" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Our Mission</a>
          </li>
          <li>
            <a href="/about#principles" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Core Principles</a>
          </li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="space-y-3">
        <p class="text-[11px] font-mono uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100">Legal & Privacy</p>
        <ul class="space-y-2">
          <li>
            <a href="/privacy-policy" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Terms of Service</a>
          </li>
          <li>
            <a href="/privacy-policy#data-handling" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Data Security</a>
          </li>
          <li>
            <a href="/terms#commercial-use" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Commercial Use</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Attribution & Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">
      <p data-i18n="footerCopyright">© {year} Quote Generator Free. 100% Free & Open In-Browser Tool.</p>
      <div class="flex items-center gap-4">
        <span data-i18n="footerNotice">No cookies · No database storage · Zero tracking</span>
        <a href="#top" class="hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors hidden sm:inline-block">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
