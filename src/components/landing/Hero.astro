---
// src/components/landing/Hero.astro
---

<section class="relative overflow-hidden pt-12 pb-8 hero-mesh-gradient no-print">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4">
    <!-- Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/90 dark:bg-neutral-900/90 border border-neutral-200 dark:border-neutral-800 shadow-2xs backdrop-blur-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span data-i18n="heroEyebrow" class="text-[11px] font-mono uppercase tracking-wider text-neutral-600 dark:text-neutral-400 font-medium">
        100% Free · No Sign-Up · Zero Server Latency
      </span>
    </div>

    <!-- Display Headline -->
    <h1 data-i18n="heroHeadline" class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-neutral-950 dark:text-white leading-[1.1] max-w-3xl mx-auto">
      Create Professional Quotations in Seconds.
    </h1>

    <!-- Subtitle -->
    <p data-i18n="heroSubtitle" class="text-xs sm:text-base text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
      A fast, free online quotation generator for freelancers, agencies, and businesses. Add your logo, calculate taxes, customize designer templates, preview in real time, and download high-resolution PDFs instantly.
    </p>

    <!-- Trust Badges -->
    <div class="flex flex-wrap items-center justify-center gap-y-2 gap-x-5 text-xs text-neutral-500 dark:text-neutral-400 font-mono pt-2">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span data-i18n="badgeLogoEngine">Universal Logo Engine</span>
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span data-i18n="badgePdfPreview">Live A4 PDF Preview</span>
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span data-i18n="badgeLanguages">12+ Languages & Currencies</span>
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span data-i18n="badgePrivate">100% Private (Runs In Browser)</span>
      </span>
    </div>
  </div>
</section>
