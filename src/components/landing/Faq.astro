---
// src/components/landing/Faq.astro
import { faqs } from '../../data/faqs';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answerHtml
    }
  }))
};
---

<!-- Structured Data: FAQPage JSON-LD for Search Engines -->
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd, null, 2)} />

<section id="faq" class="py-16 sm:py-24 bg-white dark:bg-[#09090b] border-t border-neutral-200 dark:border-neutral-800 transition-colors no-print">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="text-center space-y-3 mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wide bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
        <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span data-i18n="faqEyebrow">Got Questions?</span>
      </div>

      <h2 data-i18n="faqTitle" class="text-2xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white">
        Frequently Asked Questions
      </h2>

      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about our free online quotation generator, business estimate features, PDF exports, and privacy standards.
      </p>

      <!-- Quick Controls: Expand / Collapse All -->
      <div class="pt-2 flex justify-center items-center gap-3 text-xs font-mono">
        <button
          type="button"
          id="faq-expand-all"
          class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white underline underline-offset-4 transition-colors cursor-pointer"
        >
          Expand all
        </button>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <button
          type="button"
          id="faq-collapse-all"
          class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white underline underline-offset-4 transition-colors cursor-pointer"
        >
          Collapse all
        </button>
      </div>
    </div>

    <!-- FAQ Accordion List -->
    <div class="divide-y divide-neutral-200 dark:divide-neutral-800 border-y border-neutral-200 dark:border-neutral-800">
      {faqs.map((faq, index) => (
        <details
          class="faq-item group py-5 transition-colors duration-150"
          id={faq.id}
          open={index === 0}
        >
          <summary class="flex justify-between items-start gap-4 cursor-pointer list-none select-none text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 dark:focus-visible:ring-neutral-600 rounded-md py-1">
            <div class="space-y-1 pr-2">
              <span class="inline-block text-[10px] font-mono font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                {faq.category}
              </span>
              <h3 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white group-hover:text-neutral-600 dark:group-hover:text-neutral-200 transition-colors">
                {faq.question}
              </h3>
            </div>
            <span class="mt-1 shrink-0 w-6 h-6 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 dark:text-neutral-400 group-hover:bg-neutral-200 dark:group-hover:bg-neutral-700 transition-colors">
              <svg
                class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div
            class="faq-answer mt-3 pl-0 sm:pl-1 pr-6 sm:pr-8 text-xs sm:text-sm leading-relaxed text-neutral-600 dark:text-neutral-300 font-normal space-y-2 [&>p]:leading-relaxed [&>ul]:space-y-1.5 [&>ol]:space-y-1.5"
            set:html={faq.answerHtml}
          />
        </details>
      ))}
    </div>

    <!-- Helpful Bottom Callout -->
    <div class="mt-12 p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900/60 border border-neutral-200 dark:border-neutral-800 text-center space-y-3">
      <h4 class="text-base font-semibold text-neutral-900 dark:text-white">
        Ready to create your first business quote?
      </h4>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-md mx-auto">
        No account setup, no credit cards, and no paywalls. Create, calculate, and download a professional PDF quotation in seconds.
      </p>
      <div class="pt-1">
        <a
          href="#editor"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs sm:text-sm font-medium bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-sm active:scale-95"
        >
          <span>Start Generating Quotes Now</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Client-side expand/collapse all controls
  const expandBtn = document.getElementById('faq-expand-all');
  const collapseBtn = document.getElementById('faq-collapse-all');

  expandBtn?.addEventListener('click', () => {
    document.querySelectorAll('#faq details').forEach((el) => {
      (el as HTMLDetailsElement).open = true;
    });
  });

  collapseBtn?.addEventListener('click', () => {
    document.querySelectorAll('#faq details').forEach((el) => {
      (el as HTMLDetailsElement).open = false;
    });
  });
</script>
